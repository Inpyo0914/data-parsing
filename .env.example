# ========================================
# Financial Data Parser - Environment Variables
# ========================================
# IMPORTANT: Copy this file to .env and configure your settings
# Never commit .env to version control!

# FinancialJuice Crawler Settings
FINANCIAL_JUICE_BASE_URL=https://www.financialjuice.com
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; DataParser/1.0)
CRAWLER_DELAY=2
CRAWLER_TIMEOUT=30
CRAWLER_MAX_RETRIES=3

# Elasticsearch Settings
ES_HOST=localhost
ES_PORT=9200
ES_INDEX_PREFIX=financial_data
# Leave empty if authentication is not required
ES_USERNAME=
ES_PASSWORD=

# Flask Settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False

# ⚠️  CRITICAL SECURITY WARNING ⚠️
# NEVER use the default secret key in production!
# Generate a secure random key with:
#   python -c 'import secrets; print(secrets.token_hex(32))'
# Or:
#   openssl rand -hex 32
FLASK_SECRET_KEY=INSECURE-PLEASE-CHANGE-THIS-IMMEDIATELY

# Scheduler Settings
# Cron format: minute hour day month day_of_week
# Default: Run at 9AM, 3PM, 9PM daily
COLLECTION_SCHEDULE=0 9,15,21 * * *

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Development Settings
ENVIRONMENT=development
