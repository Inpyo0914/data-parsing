# FinancialJuice Crawler Settings
FINANCIAL_JUICE_BASE_URL=https://www.financialjuice.com
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; DataParser/1.0)
CRAWLER_DELAY=2
CRAWLER_TIMEOUT=30
CRAWLER_MAX_RETRIES=3

# Elasticsearch Settings
ES_HOST=localhost
ES_PORT=9200
ES_INDEX_PREFIX=financial_data
ES_USERNAME=
ES_PASSWORD=

# Flask Settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False
FLASK_SECRET_KEY=change-this-to-a-random-secret-key

# Scheduler Settings
# Cron format: minute hour day month day_of_week
# Default: Run at 9AM, 3PM, 9PM daily
COLLECTION_SCHEDULE=0 9,15,21 * * *

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Development Settings
ENVIRONMENT=development
